# URL canonico pubblico del sito, senza slash finale.
# Deve essere il dominio verificato in Search Console e Merchant Center.
NEXT_PUBLIC_SITE_URL=https://www.mirailabstore.com
NEXT_PUBLIC_APP_URL=https://www.mirailabstore.com

# PostHog (variabili pubbliche usate esclusivamente dal browser dopo il consenso).
# L'host deve corrispondere alla regione del progetto, ad esempio https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Verifica facoltativa di Google Search Console (solo il valore del meta tag).
GOOGLE_SITE_VERIFICATION=

# Meta Pixel (identificatore pubblico usato dal browser)
NEXT_PUBLIC_META_PIXEL_ID=1373791028153076
# Configurazione server-side per Meta Conversions API (non usare NEXT_PUBLIC_)
META_DATASET_ID=
META_CONVERSIONS_API_TOKEN=
META_TEST_EVENT_CODE=

# Stripe: usa chiavi dello stesso ambiente (entrambe live oppure entrambe test)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Firma del webhook Stripe configurato su /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Segreto casuale server-side per firmare le conferme ordine.
CHECKOUT_CONFIRMATION_SECRET=

# Resend (server-side only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=MIRΛI LAB STORE <customer@mirailabstore.com>
RESEND_REPLY_TO=info@mirailabstore.com
# Usati da Vercel Cron e dai link firmati di disiscrizione.
CRON_SECRET=
EMAIL_UNSUBSCRIBE_SECRET=

# Supabase: URL e anon key sono pubbliche; secret/service role solo server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Segreto casuale server-side per gli identificatori anonimi del rate limiting.
RATE_LIMIT_SECRET=

# Vercel Blob (server-side only)
BLOB_READ_WRITE_TOKEN=

MIRAI_DISCOUNT_CODES=
ADMIN_EMAIL=mattyventura02@gmail.com
ADMIN_PASSWORD=

# MIRΛ AI (server-side only: never expose this as NEXT_PUBLIC_*)
OPENAI_API_KEY=
OPENAI_MIRA_MODEL=gpt-5-mini
